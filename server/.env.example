# Скопируй в .env и заполни. Файл .env никому не отправляй.

# Бот: токен от @BotFather и твой Telegram user id (узнать у @userinfobot)
BOT_TOKEN=
OWNER_TG_ID=

# Supabase: Project Settings -> Database -> Connection string (Session pooler, URI)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# Claude API: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_SCAN_MODEL=claude-haiku-5-5

TZ_NAME=Asia/Tashkent
REMIND_CHARGE_HOUR=20
REMIND_PACK_HOURS=3
REMIND_GO_MINUTES=60
DIGEST_HOUR=9

# Сканер: my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION=/home/ubuntu/.config/shotday/scanner
SCAN_EVERY_MIN=120
SCAN_FIRST_DAYS=3
SCAN_MAX_GROUP_MEMBERS=30
# Подстроки названий чатов, которые не читаем никогда (через запятую, без учёта регистра)
SCAN_BLACKLIST=
